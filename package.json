{
  "name": "archdream",
  "version": "1.0.1",
  "description": "CLI that scaffolds folder structures from architecture presets",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "archdream": "dist/cli.js"
  },
  "files": [
    "dist",
    "architecture"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "scaffold",
    "architecture"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
